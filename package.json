{
  "name": "org-management",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @org/server",
    "dev:web": "npm run dev --workspace @org/web",
    "build": "npm run build --workspace @org/server && npm run build --workspace @org/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @org/server"
  },
  "engines": {
    "node": ">=22"
  }
}
