# Copy to .env for local development.
NODE_ENV=development
PORT=3000
# Embedded PostgreSQL for local dev. Production: postgres://user:pass@host:5432/db
DATABASE_URL=pglite:./.data/pglite
APP_URL=http://localhost:5173
# Google Identity Services OAuth client ID (Web). Leave empty to use dev login only.
GOOGLE_CLIENT_ID=
AUTH_DEV_LOGIN=true
WORKER_MODE=inline
MAIL_TRANSPORT=console
# SMTP_URL=smtps://user:pass@smtp.example.org:465
MAIL_FROM=Organization Tasks <no-reply@example.org>
BOOTSTRAP_ORG_NAME=הארגון
BOOTSTRAP_MANAGER_EMAILS=manager@example.org,partner@example.org
